interface IAttack
{
    // called in the begining
    void AttackPrepareStart();
    // attack function
    void AttackCommence();
    // called at the end, right before next attack calls attackPrepareStart
    void AttackRecuperationEnd();
};

// Worldmap event bosses accelerate at four or more living players:
// 4 players = 10%, then +5 percentage points per additional player, capped at 50%.
uint EventBossPlayerHaste(Critter@ boss)
{
    if(!valid(boss))
        return 0;
    Map@ map = boss.GetMap();
    if(!valid(map))
        return 0;
    array<Critter@> players;
    uint count = map.GetCritters(0, FIND_ONLY_PLAYERS | FIND_LIFE_AND_KO, players);
    if(count <= 3)
        return 0;
    uint haste = 10 + (count - 4) * 5;
    return haste > 50 ? 50 : haste;
}

uint EventBossScaledDelay(Critter@ boss, uint delay)
{
    uint haste = EventBossPlayerHaste(boss);
    uint scaled = delay * (100 - haste) / 100;
    return scaled > 0 ? scaled : 1;
}




class CBoss
{

    uint            id;

    uint            timeEvent;

    array<uint>     critterList;
    array<IAttack@> attacks;
    array<int>      attackChances;
    int             totalChance;
    uint            currentAttack;
    array<int>      attackPrepareTimes;
    array<int>      attackRecuperations;
    array<string>   attackNames;
    string          currentAttackName;
    string          specialAttackName;
    uint            specialAttackSerial;
    string          hudAttackName;
    uint            hudAttackSerial;
    uint            hudAttackUntil;
    array<uint>     trackedLegPlayerIds;
    array<uint>     trackedLegMasks;
    array<uint>     pendingBombPlayerIds;

    //
    bool patern;
    bool scaleWithPlayers;

    CBoss()
    {
        uint id = 0;

        timeEvent = 0;

        critterList = array<uint>(0);
        attacks = array<IAttack@>(0);
        attackChances = array<int>(0);
        totalChance = 0;
        currentAttack = 0;
        attackPrepareTimes = array<int>(0);
        attackRecuperations = array<int>(0);
        attackNames = array<string>(0);
        currentAttackName = "";
        specialAttackName = "";
        specialAttackSerial = 0;
        hudAttackName = "";
        hudAttackSerial = 0;
        hudAttackUntil = 0;
        trackedLegPlayerIds = array<uint>(0);
        trackedLegMasks = array<uint>(0);
        pendingBombPlayerIds = array<uint>(0);

        patern = false;
        scaleWithPlayers = false;
    }


    void SetId(uint id)
    {
        this.id = id;
    }

    void AddAttack(IAttack@ attack, int chance, int timeBeforeAttack, int timeAfterAttack, string attackName)
    {
        attacks.insertLast(attack);
        attackChances.insertLast(chance);
        totalChance += chance;
        attackPrepareTimes.insertLast(timeBeforeAttack);
        attackRecuperations.insertLast(timeAfterAttack);
        attackNames.insertLast(attackName);
    }

    void AddCritter(Critter& crit)
    {
        critterList.insertLast(crit.Id);
        crit.StatBase[ST_NPC_BOSS] = 1;   // MOB_IS_BOSS; grants shared boss-only protections
        if(crit.PerkBase[PE_STONEWALL] == 0)
            crit.PerkBase[PE_STONEWALL] = 1;
        crit.SetEvent(CRITTER_EVENT_SHOW_CRITTER, "_BossShowCritter");
        crit.SetEvent(CRITTER_EVENT_ATTACKED, "_BossAttacked");
        crit.SetEvent(CRITTER_EVENT_FINISH, "_BossFinish");
        crit.SetEvent(CRITTER_EVENT_DEAD, "_BossDead");
        crit.ParamBase[ST_VAR0] = id;

        // Each limb keeps its own break timestamp. Ten seconds after detecting a
        // cripple, bosses clear the injury and restore that limb's HP completely.
        array<uint> doctor = { crit.Id, 0, 0, 0, 0 };
        CreateTimeEvent(0, "e_BossDoctor", doctor, true);
    }

    void AnnounceSpecialAttack(string attackName, uint duration)
    {
        specialAttackName = attackName;
        specialAttackSerial++;
        hudAttackName = attackName;
        hudAttackSerial++;
        hudAttackUntil = __FullSecond + REAL_SECOND(2);
        array<uint> clearData = { id, specialAttackSerial };
        CreateTimeEvent(AFTER(duration), "e_BossClearSpecialAttack", clearData, false);
    }

    string HudAttack()
    {
        return __FullSecond <= hudAttackUntil ? hudAttackName : "";
    }

    void MakeAgressive()
    {
        aggressionStart();

        startAttack();
    }

    void startAttack()
    {
        if(patern)
        {
            currentAttack = (currentAttack + 1) % attacks.length();
        }
        else
        {
            int roll = Random(0, totalChance - 1);
            int sum = 0;
            int i = 0;
            int j = attacks.length();
            for( ; i < j; i++)
            {
                sum += attackChances[i];
                if(sum > roll)
                    break;
            }
            currentAttack = i;
        }
        currentAttackName = attackNames[currentAttack];
        hudAttackName = currentAttackName;
        hudAttackSerial++;
        hudAttackUntil = __FullSecond + REAL_SECOND(2);
        attacks[currentAttack].AttackPrepareStart();
        array<int> vals = { id };
        uint delay = uint(attackPrepareTimes[currentAttack]);
        if(scaleWithPlayers && critterList.length() > 0)
            delay = EventBossScaledDelay(GetCritter(critterList[0]), delay);
        timeEvent = CreateTimeEvent(AFTER(delay), "e_CommenceAttack", vals, false);
    }

    void commenceAttack()
    {
        attacks[currentAttack].AttackCommence();
        array<int> vals = { id };
        uint delay = uint(attackRecuperations[currentAttack]);
        if(scaleWithPlayers && critterList.length() > 0)
            delay = EventBossScaledDelay(GetCritter(critterList[0]), delay);
        timeEvent = CreateTimeEvent(AFTER(delay), "e_FinishAttack", vals, false);
    }

    void finishAttack()
    {
        attacks[currentAttack].AttackRecuperationEnd();
        startAttack();
    }

    void aggressionStart()
    {}

    void bossSee(Critter& cr, Critter& shownCr)
    {}

    bool bossAttacked(Critter& cr, Critter& attacker)
    {
        return false;
    }

    void bossHit(Critter& cr, Critter@ attacker, int dmg)
    {}

    void bossKilled(Critter& cr, Critter@ attacker)
    {}

    void bossFinish(Critter& cr, bool deleted)
    {}

};

uint e_BossDoctor(array<uint>@ values)
{
    Critter@ boss = GetCritter(values[0]);
    if(!valid(boss) || boss.IsDead() || boss.Stat[ST_NPC_BOSS] == 0)
        return 0;

    array<uint> damageParams =
    {
        DAMAGE_RIGHT_ARM, DAMAGE_LEFT_ARM, DAMAGE_RIGHT_LEG, DAMAGE_LEFT_LEG
    };
    array<uint> hpParams = { ST_HP_RA, ST_HP_LA, ST_HP_RL, ST_HP_LL };
    int maxLimbHp = GetActualMaxLimbHp(boss);
    bool repaired = false;

    for(uint i = 0; i < damageParams.length(); i++)
    {
        if(boss.Damage[damageParams[i]] == 0)
        {
            values[i + 1] = 0;
            continue;
        }

        if(values[i + 1] == 0)
            values[i + 1] = __FullSecond;
        else if(__FullSecond >= values[i + 1] + REAL_SECOND(10))
        {
            boss.DamageBase[damageParams[i]] = 0;
            boss.StatBase[hpParams[i]] = maxLimbHp;
            values[i + 1] = 0;
            repaired = true;
        }
    }

    if(repaired)
        boss.Say(SAY_SHOUT_ON_HEAD, "*repairs crippled limbs*");
    return REAL_SECOND(1);
}

uint e_BossClearSpecialAttack(array<uint>@ values)
{
    CBoss@ boss = GetBoss(values[0]);
    if(valid(boss) && boss.specialAttackSerial == values[1])
        boss.specialAttackName = "";
    return 0;
}

uint e_CommenceAttack(array<int>@ vals)
{
    CBoss@ boss = GetBoss(vals[0]);
    if(valid(boss))
        boss.commenceAttack();
    return 0;
}

uint e_FinishAttack(array<int>@ vals)
{
    CBoss@ boss = GetBoss(vals[0]);
    if(valid(boss))
        boss.finishAttack();
    return 0;
}

void _BossShowCritter(Critter& cr, Critter& shownCr)
{
    CBoss@ boss = GetBoss(cr.Param[ST_VAR0]);
    if(valid(boss))
        boss.bossSee(cr, shownCr);
}

bool _BossAttacked(Critter& cr, Critter& attacker)
{
    bool   retVal = false;
    CBoss@ boss = GetBoss(cr.Param[ST_VAR0]);
    if(valid(boss))
        retVal = boss.bossAttacked(cr, attacker);

    array<uint> vals = { cr.Id, attacker.Id, cr.Param[ST_CURRENT_HP] };
    cr.ParamBase[ST_VAR1] = CreateTimeEvent(0, "_BossHit", vals, false);
    return retVal;
}

uint _BossHit(array<uint>@ values)
{
    Critter@ cr = GetCritter(values[0]);
    if(!valid(cr))
        return 0;
    Critter@ attacker = GetCritter(values[1]);
    int      damage = int(values[2]) - cr.Param[ST_CURRENT_HP];

    cr.ParamBase[ST_VAR1] = 0;

    CBoss@ boss = GetBoss(cr.Param[ST_VAR0]);
    if(valid(boss))
        boss.bossHit(cr, attacker, damage);

    return 0;
}

void _BossDead(Critter& cr, Critter@ killer)
{
    if(cr.Param[ST_VAR1] != 0)
    {
        EraseTimeEvent(cr.Param[ST_VAR1]);
        cr.ParamBase[ST_VAR1] = 0;
    }

    CBoss@ boss = GetBoss(cr.Param[ST_VAR0]);
    if(valid(boss))
        boss.bossKilled(cr, killer);
}

void _BossFinish(Critter& cr, bool deleted)
{
    if(cr.Param[ST_VAR1] != 0)
    {
        EraseTimeEvent(cr.Param[ST_VAR1]);
        cr.ParamBase[ST_VAR1] = 0;
    }

    CBoss@ boss = GetBoss(cr.Param[ST_VAR0]);
    if(valid(boss))
        boss.bossFinish(cr, deleted);
}

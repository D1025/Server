import bool GMToolsAccess() from "client_gmtools";
import bool IsGMTEnabled() from "client_main";
#define IsGM    IsGMTEnabled() && GMToolsAccess

import int stringReplaceText(string& s, string@ f, string@ t) from "config_file";
import int GUI_GetActiveMainScreen() from "client_gui";
import int GUI_GetActiveScreen() from "client_gui";
import bool IsHexInSmoke(uint16 hexX, uint16 hexY) from "client_interface";

array<CritterCl@> crs;
uint[] ClassExecutionMarkTargets;
int[] ClassExecutionMarkHp;
uint[] ClassExecutionMarkExpires;

#define CRITTER_STATUS_ICON_SIZE      (16)
#define CRITTER_STATUS_ICON_GAP       (2)
#define CRITTER_STATUS_ICON_TEXT_GAP  (2)

uint CritterStatusIconDeploy;
uint CritterStatusIconPrepared;
uint CritterStatusIconRevive;
uint CritterStatusIconFevShield;
uint CritterStatusIconBurrow;
uint CritterStatusIconUnderground;
uint CritterStatusIconRage;
uint CritterStatusIconEmerging;
uint CritterStatusIconExecutionMark;
bool CritterStatusIconsLoaded;

int Class_FindExecutionMark(uint targetId)
{
	for(uint i = 0; i < ClassExecutionMarkTargets.length(); i++)
		if(ClassExecutionMarkTargets[i] == targetId)
			return int(i);
	return -1;
}

void Class_ShowExecutionMark(int targetId, int executeHp, int duration, string@, array<int>@) // Export
{
	if(targetId <= 0 || executeHp <= 0 || duration <= 0)
		return;
	int index = Class_FindExecutionMark(uint(targetId));
	if(index < 0)
	{
		ClassExecutionMarkTargets.insertLast(uint(targetId));
		ClassExecutionMarkHp.insertLast(executeHp);
		ClassExecutionMarkExpires.insertLast(ELAPSED_TIME + uint(duration));
		return;
	}
	ClassExecutionMarkHp[index] = executeHp;
	ClassExecutionMarkExpires[index] = ELAPSED_TIME + uint(duration);
}

void Class_HideExecutionMark(int targetId, int, int, string@, array<int>@) // Export
{
	int index = Class_FindExecutionMark(uint(MAX(0, targetId)));
	if(index < 0)
		return;
	ClassExecutionMarkTargets.removeAt(index);
	ClassExecutionMarkHp.removeAt(index);
	ClassExecutionMarkExpires.removeAt(index);
}

int Class_GetExecutionMarkHp(uint targetId)
{
	int index = Class_FindExecutionMark(targetId);
	if(index < 0)
		return 0;
	if(ClassExecutionMarkExpires[index] <= ELAPSED_TIME)
	{
		ClassExecutionMarkTargets.removeAt(index);
		ClassExecutionMarkHp.removeAt(index);
		ClassExecutionMarkExpires.removeAt(index);
		return 0;
	}
	return ClassExecutionMarkHp[index];
}

void AddCritterStatusIcon(array<uint>& icons, uint spriteId)
{
	if(spriteId != 0)
		icons.insertLast(spriteId);
}

void LoadCritterStatusIcons()
{
	if(CritterStatusIconDeploy == 0)
		CritterStatusIconDeploy = LoadSprite("deploy.FRM", PT_ART_INTRFACE);
	if(CritterStatusIconPrepared == 0)
		CritterStatusIconPrepared = LoadSprite("prepared.FRM", PT_ART_INTRFACE);
	if(CritterStatusIconRevive == 0)
		CritterStatusIconRevive = LoadSprite("revive.FRM", PT_ART_INTRFACE);
	if(CritterStatusIconFevShield == 0)
		CritterStatusIconFevShield = LoadSprite("fev_shield.FRM", PT_ART_INTRFACE);
	if(CritterStatusIconBurrow == 0)
		CritterStatusIconBurrow = LoadSprite("burrow.FRM", PT_ART_INTRFACE);
	if(CritterStatusIconUnderground == 0)
		CritterStatusIconUnderground = LoadSprite("underground.FRM", PT_ART_INTRFACE);
	if(CritterStatusIconRage == 0)
		CritterStatusIconRage = LoadSprite("rage.FRM", PT_ART_INTRFACE);
	if(CritterStatusIconEmerging == 0)
		CritterStatusIconEmerging = LoadSprite("emerging.FRM", PT_ART_INTRFACE);
	if(CritterStatusIconExecutionMark == 0)
		CritterStatusIconExecutionMark = LoadSprite("execution_mark.FRM", PT_ART_INTRFACE);

	CritterStatusIconsLoaded = CritterStatusIconDeploy != 0 &&
	                           CritterStatusIconPrepared != 0 &&
	                           CritterStatusIconRevive != 0 &&
	                           CritterStatusIconFevShield != 0 &&
	                           CritterStatusIconBurrow != 0 &&
	                           CritterStatusIconUnderground != 0 &&
	                           CritterStatusIconRage != 0 &&
	                           CritterStatusIconEmerging != 0 &&
	                           CritterStatusIconExecutionMark != 0;
}

void DrawCritterStatusIcons(CritterCl& cr)
{
	if(!CritterStatusIconsLoaded)
		LoadCritterStatusIcons();

	array<uint> icons;

	if(cr.Param[ST_DEPLOYED] != 0)
		AddCritterStatusIcon(icons, CritterStatusIconDeploy);

	if(cr.Param[ST_CLASS_ID] == CLASS_MARKSMAN &&
	   cr.Param[ST_CLASS_EFFECT] == CLASS_EFFECT_MARKSMAN_PREPARED)
		AddCritterStatusIcon(icons, CritterStatusIconPrepared);
	else if(cr.Param[ST_CLASS_ID] == CLASS_PARAMEDIC &&
	        cr.Param[ST_CLASS_EFFECT] == CLASS_EFFECT_PARAMEDIC_REVIVING)
		AddCritterStatusIcon(icons, CritterStatusIconRevive);
	else if(cr.Param[ST_CLASS_ID] == CLASS_SUPER_MUTANT &&
	        cr.Param[ST_CLASS_EFFECT] == CLASS_EFFECT_SUPER_MUTANT_FEV_RUSH)
		AddCritterStatusIcon(icons, CritterStatusIconFevShield);
	else if(cr.Param[ST_CLASS_ID] == CLASS_DEATHCLAW)
	{
		if(cr.Param[ST_CLASS_EFFECT] == CLASS_EFFECT_DEATHCLAW_BURROWING)
			AddCritterStatusIcon(icons, CritterStatusIconBurrow);
		else if(cr.Param[ST_CLASS_EFFECT] == CLASS_EFFECT_DEATHCLAW_UNDERGROUND)
			AddCritterStatusIcon(icons, CritterStatusIconUnderground);
		else if(cr.Param[ST_CLASS_EFFECT] == CLASS_EFFECT_DEATHCLAW_RAGE)
			AddCritterStatusIcon(icons, CritterStatusIconRage);
		else if(cr.Param[ST_CLASS_EFFECT] == CLASS_EFFECT_DEATHCLAW_RECOVERY)
			AddCritterStatusIcon(icons, CritterStatusIconEmerging);
	}

	if(Class_GetExecutionMarkHp(cr.Id) > 0)
		AddCritterStatusIcon(icons, CritterStatusIconExecutionMark);

	if(icons.length() == 0)
		return;

	int textX = 0;
	int textY = 0;
	if(!GetNameTextInfo(cr, textX, textY))
		return;

	string onHeadText = cr.NameOnHead;
	if(onHeadText.length() == 0)
		onHeadText = cr.Name;

	// A name without awareness/HP starts with a formatting newline. It does not
	// draw any text, so do not reserve its height between the icon row and name.
	if(onHeadText.rawLength() > 0 && onHeadText.rawGet(0) == 10)
	{
		uint textLength = onHeadText.rawLength();
		for(uint i = 1; i < textLength; i++)
			onHeadText.rawSet(i - 1, onHeadText.rawGet(i));
		onHeadText.rawResize(textLength - 1);
	}

	int textWidth = 0;
	int textHeight = 0;
	int textLines = 0;
	GetTextInfo(onHeadText, 200, 70, -1, FT_CENTERX | FT_BOTTOM | FT_BORDERED,
	            textWidth, textHeight, textLines);

	int iconCount = int(icons.length());
	int rowWidth = iconCount * CRITTER_STATUS_ICON_SIZE +
	               (iconCount - 1) * CRITTER_STATUS_ICON_GAP;
	int x = textX + 100 - rowWidth / 2;
	int y = textY + 70 - textHeight - CRITTER_STATUS_ICON_TEXT_GAP -
	        CRITTER_STATUS_ICON_SIZE;

	if(x >= __ScreenWidth || x + rowWidth <= 0 ||
	   y >= __ScreenHeight || y + CRITTER_STATUS_ICON_SIZE <= 0)
		return;

	for(int i = 0; i < iconCount; i++)
	{
		DrawSprite(icons[i], -1, x, y, CRITTER_STATUS_ICON_SIZE,
		           CRITTER_STATUS_ICON_SIZE, false, true, 0);
		x += CRITTER_STATUS_ICON_SIZE + CRITTER_STATUS_ICON_GAP;
	}
}

void InitCritterOnHead()	//export
{
	__ShowNpcNames = __ConfigShowNpcAwareness;
	CritterStatusIconsLoaded = false;
}

void DrawCritterOnHead()	//export
{
	if(GUI_GetActiveMainScreen() != CLIENT_MAIN_SCREEN_GAME)
		return;

	crs.resize(0);
	GetCritters( 0, FIND_ALL, crs );

	int color_b = 0;
	int color_g = 0;
	int color_r = 0;
	int hp_proc = 0;
	string name;
	string hp;
	string inj;
	string crInjures;
	string mobDesc;
	string playerDesc;

	CritterCl@ chosen = GetChosen();

	for(uint  i = 0, imax = crs.length(); i < imax; i ++)
	{
		// Players standing in smoke stay anonymous: the silhouette is visible
		// (IR goggles / adjacency), but no nickname or awareness info.
		// Own team and GMs still see names.
		if(crs[i].IsPlayer() && valid(chosen) && crs[i].Id != chosen.Id && !(IsGM())
		   && !(chosen.Stat[ST_TEAM_ID] != 0 && crs[i].Stat[ST_TEAM_ID] == chosen.Stat[ST_TEAM_ID])
		   && IsHexInSmoke(crs[i].HexX, crs[i].HexY))
		{
			crs[i].NameOnHead = " ";
			continue;
		}

		//OnHeadAwareness
		uint   dialog = crs[i].Stat[ST_DIALOG_ID];
        uint16 pid = crs[i].Pid;
        string head = (crs[i].IsPlayer() ? crs[i].Name : " ");

        if(IsLexem(crs[i], "$@"))
        {
            head = GetLexem(crs[i], "$@");
            if(head.length() == 0)
                head = " ";
			
			stringReplaceText(head, "|", "");
            head = FormatTags(head, "");
        }

        if(IsGM())
        {
            array<string> gm;

            string        id = "<" + crs[i].Id + ">";

            if((crs[i].IsPlayer() && head != crs[i].Name) || (crs[i].IsNpc() && IsLexem(crs[i], "$@")))
            {
                if(crs[i].IsPlayer())
                    gm.insertLast("Player: " + crs[i].Name);
                else if(crs[i].IsNpc())
                    gm.insertLast("NPC: " + GetMsgStr(TEXTMSG_DLG, STR_NPC_NAME(dialog, pid)));
            }

            if(__ShowCritId)
                gm.insertLast("ID: " + crs[i].Id);

            if(crs[i].Param[MODE_HIDE] > 0)
                gm.insertLast("sneaked");

            if(gm.length() > 0)
            {
                head += "|" + COLOR_RGB(0xFF, 0xFF, 0xFF) + " ";
                for(uint g = 0, gLen = gm.length(); g < gLen; g++)
                {
                    head += "\n(" + gm[g] + ")";
                }
            }
        }

		if(head != " ")
		{
			name = "\n" +  "|" + crs[i].NameColor + " " + head;
			crs[i].ContourColor = crs[i].ContourColor;
			
			if(crs[i].Stat[ST_TEAM_ID] == chosen.Stat[ST_TEAM_ID] && crs[i].Id != chosen.Id && crs[i].Param[MODE_HIDE] != 0)
				name = name + " (sneaked)";
		}
		else
			name = " ";

		if(crs[i].IsPlayer() && crs[i].Param[ST_NPC_BOSS] > 0)
		{
			switch(crs[i].Param[ST_NPC_BOSS])
			{
				case 1 : playerDesc = "\n|" + COLOR_RGB(255, 255, 255) + " -TESTER-"; break;
				case 2 : playerDesc = "\n|" + COLOR_RGB(255, 255, 255) + " -GAME MASTER-"; break;
				case 3 : playerDesc = "\n|" + COLOR_RGB(255, 255, 255) + " -ADMINISTRATOR-"; break;
			}
		}
		else
			playerDesc = "";
		
		
		if(crs[i].IsPlayer() && !__ConfigShowPlayerAwareness)
		{
			crs[i].NameOnHead = name;
			DrawCritterStatusIcons(crs[i]);
			continue;	
		}
		if((crs[i].IsLife() || crs[i].IsKnockout()) && crs[i].Param[ST_NPC_ROLE] == 203 /*ROLE_MOB_DYNAMIC*/ && crs[i].IsNpc())
		{
			switch(GetCurrentMapPid())
			{
				case MAP_NCR :
				case MAP_Adytum :
				case MAP_HubDowntown :
				case MAP_Junktown :
				case MAP_SanFranChina :
				case MAP_VaultCityDowntown :
					if(crs[i].Param[ST_NPC_BOSS] == 1 /*MOB_IS_BOSS*/) mobDesc = "\n|" + COLOR_RGB(200, 0, 0) + " Boss of Town Raiders";
					else  mobDesc = "\n|" + COLOR_RGB(200, 0, 0) + " Town Raider";
					break;
				default:
					if(crs[i].Param[ST_NPC_BOSS] == 1 /*MOB_IS_BOSS*/) mobDesc = "\n|" + COLOR_RGB(200, 0, 0) + " BOSS";
					else  mobDesc = "";
					break;
				}					
			}
		else if(crs[i].Param[ST_NPC_ROLE] == 205 /*ROLE_REWARD_GIVER*/ && crs[i].IsNpc())
		{
			switch(GetCurrentMapPid())
			{
				case MAP_NCR :
				case MAP_Adytum :
				case MAP_HubDowntown :
				case MAP_Junktown :
				case MAP_SanFranChina :
				case MAP_VaultCityDowntown :
					mobDesc = "\n|" + COLOR_CRITTER_NAME + " -Reward Giver-";
					break;
			}					
		}
		else
				mobDesc = "";
				
		if(crs[i].IsNpc() && !__ConfigShowNpcAwareness)
		{
			crs[i].NameOnHead = name;
			DrawCritterStatusIcons(crs[i]);
			continue;
		}

		if(crs[i].IsDead() == false)
		{
			if(valid(chosen) && __ConfigOnHeadAwareness == 1)
			{
			    ItemCl@ utility = crs[i].GetItem(0, SLOT_UTILITY);
			    bool personalShieldReady = valid(utility) && utility.GetProtoId() == PID_PERSONAL_SHIELD_GENERATOR &&
			                               crs[i].Timeout[TO_UTILITY_COOLDOWN] <= 0;

			    if (crs[i].IsNpc()) {
			        int maxHp = crs[i].Param[ST_MAX_LIFE];
			        int green = CLAMP(CLAMP(crs[i].Param[ST_CURRENT_HP], -999, maxHp) * 0xff / maxHp, 0, 0xff);
			        string hpText = "" + crs[i].Param[ST_CURRENT_HP];
			        if(personalShieldReady)
			            hpText = "[" + hpText + "]";
			        hp = "|" + COLOR_RGB(255-green, green, 0) + " HP: " + hpText;
			    } else {
			    				int maxhp = crs[i].Param[ST_MAX_LIFE];
                				color_g = (255*crs[i].Param[ST_CURRENT_HP])/maxhp;
                				hp_proc = crs[i].Param[ST_CURRENT_HP] * 100 / maxhp;

                				if(color_g < 0)
                					color_g = 0;
                				color_r = 255 - color_g;

                                string hpText = crs[i].Param[ST_CURRENT_HP] + "/" + maxhp;
                                if(personalShieldReady)
                                    hpText = "[" + hpText + "]";
                                hp = "|" + COLOR_RGB(color_r, color_g, color_b) + " " + hpText;
			    }
			}
			else
			{
				string lifeRes = "";
				switch(crs[i].Stat[ST_HEALTH_LEVEL])
				{
					case 4: lifeRes = "****"; break;
					case 3: lifeRes = "***"; break;
					case 2: lifeRes = "**"; break;
					case 1: lifeRes = "*"; break;
				}
				
				hp = "|" + (crs[i].Stat[ST_HEALTH_LEVEL] < 1 ? COLOR_LGRAY : COLOR_RGB(0xff - (0xff * crs[i].Stat[ST_HEALTH_LEVEL]) / 5, (0xff * crs[i].Stat[ST_HEALTH_LEVEL]) / 5, 0)) + " " + lifeRes;
			}
			
			if(valid(chosen) && _CritIsInjured(crs[i]))
			{
				crInjures = " ";
				crInjures += _CritDamaged(crs[i], DAMAGE_EYE) ? "E " : "";
                crInjures += _CritDamaged(crs[i], DAMAGE_RIGHT_ARM) ? "RA " : "";
                crInjures += _CritDamaged(crs[i], DAMAGE_LEFT_ARM) ? "LA " : "";
                crInjures += _CritDamaged(crs[i], DAMAGE_RIGHT_LEG) ? "RL " : "";
                crInjures += _CritDamaged(crs[i], DAMAGE_LEFT_LEG) ? "LL " : "";
				inj = "|" + COLOR_RGB(200, 0, 0) + crInjures + "\n"; 
			}
			else
				inj = "";
		}
		else 
		{
			crs[i].NameOnHead = name;
			DrawCritterStatusIcons(crs[i]);
			continue;	
		}
		
		
		crs[i].NameOnHead = inj + hp + mobDesc + playerDesc + name;
		DrawCritterStatusIcons(crs[i]);
	}
}

void ChangeOnHeadAwarenessPlayer()	//export
{
	__ConfigShowPlayerAwareness = !__ConfigShowPlayerAwareness;
}

void ChangeOnHeadAwarenessNPC()	//export
{
	__ConfigShowNpcAwareness = !__ConfigShowNpcAwareness;
	__ShowNpcNames =  __ConfigShowNpcAwareness;
}
